{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelServerReadyPayload",
  "description": "`model_server_ready` — a per-role server is up and serving.",
  "type": "object",
  "required": [
    "id",
    "port",
    "role"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "port": {
      "description": "Loopback port the server bound.",
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "role": {
      "type": "string"
    }
  }
}
