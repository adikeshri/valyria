{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApprovalRequestedPayload",
  "description": "`approval_requested` — the agent is blocked on a permission decision.",
  "type": "object",
  "required": [
    "category",
    "prompt",
    "request_id",
    "risk",
    "target",
    "tool"
  ],
  "properties": {
    "category": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "request_id": {
      "description": "Stable identity to pass back to `permission_resolve` (G2).",
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    }
  }
}
