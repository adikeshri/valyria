  "definitions": {
    "CatalogRefreshRequest": {
      "description": "`catalog_refresh` (protocol 1.15.0, M6) — fetch a candidate catalog and its detached signature from `catalog_url`/`signature_url`, verify against this build's compiled-in trusted key, and (only if it's strictly newer than what's currently in effect) durably persist it as the catalog every other model-listing call reads through. Two separate URLs rather than a convention (`catalog_url` + `.sig`) because no canonical hosting for this exists yet — see `docs/ COMPLETION-PLAN.md`'s M6 section.",
      "type": "object",
      "required": [
        "catalog_url",
        "signature_url"
      ],
      "properties": {
        "catalog_url": {
          "type": "string"
        },
        "signature_url": {
          "type": "string"
        }
      }
    },
    "ConfigSetRequest": {
      "description": "Write one dotted config leaf to a Core-owned config file, then report the re-resolved effective view (§24). Additive as of protocol 1.1.0.\n\nThe write is validated against the policy floor (`valyria_config::validate_floor`) *before* it touches disk: a value that would loosen access past the compiled-in ceiling is rejected with `config.policy_floor_violation` and nothing is written.",
      "type": "object",
      "required": [
        "key",
        "scope",
        "value"
      ],
      "properties": {
        "key": {
          "description": "Dotted key, e.g. `permission.mode`, `log.format`, `network.internet`. Must be a key `config_show` already reports.",
          "type": "string"
        },
        "scope": {
          "description": "`workspace` writes `<repo>/.valyria/config.toml`; `user` writes `~/.valyria/config.toml`. Anything else is `config.invalid_scope`.",
          "type": "string"
        },
        "value": {
          "description": "The new value, as the string form `config_show` would display.",
          "type": "string"
        }
      }
    },
    "Empty": {
      "description": "An empty request payload. Kept as a named unit struct (rather than `()`) so it has a stable schema name and a place to grow fields.",
      "type": "object"
    },
    "EventsSubscribeRequest": {
      "type": "object",
      "required": [
        "since"
      ],
      "properties": {
        "since": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "task_id": {
          "description": "Restrict the stream to this task's events plus workspace-global (task-less) events (protocol 1.7.0, G11). Absent = the full stream.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "GitDiffRequest": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Restrict the diff to this exact repo-relative path.",
          "type": [
            "string",
            "null"
          ]
        },
        "staged": {
          "description": "`false` → worktree vs index (`git diff`); `true` → index vs HEAD (`git diff --staged`).",
          "default": false,
          "type": "boolean"
        }
      }
    },
    "GitLogRequest": {
      "type": "object",
      "properties": {
        "limit": {
          "description": "Newest-first commits from HEAD. Defaults to 50, capped at 500.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "HelloRequest": {
      "type": "object",
      "required": [
        "client_name"
      ],
      "properties": {
        "client_name": {
          "type": "string"
        }
      }
    },
    "LedgerChangesRequest": {
      "type": "object",
      "required": [
        "task_id"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        }
      }
    },
    "MemoryListRequest": {
      "type": "object",
      "properties": {
        "limit": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ModelActivateRequest": {
      "type": "object",
      "required": [
        "id",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "description": "The role to bind `id` to (a `ModelRole` name).",
          "type": "string"
        }
      }
    },
    "ModelEndpointAddRequest": {
      "description": "`model_endpoint_add` (protocol 1.14.0, M6) — register an already- running OpenAI-compatible server (Ollama, LM Studio, vLLM, …) that Core does not download, spawn, or manage the lifecycle of. `id` is a local name chosen by the caller, distinct from the embedded catalog's ids — it must not collide with either an installed catalog model or an existing endpoint.",
      "type": "object",
      "required": [
        "base_url",
        "id"
      ],
      "properties": {
        "base_url": {
          "description": "e.g. `http://127.0.0.1:11434/v1` — everything before `/chat/ completions` and `/health`.",
          "type": "string"
        },
        "context_length": {
          "description": "This server's actual context window. Core cannot discover it by asking the server (no standard endpoint reports it), so it must be told; defaults to a conservative 8192 when omitted.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "remote_model_name": {
          "description": "The exact model name this server expects in each request's `\"model\"` field. Many OpenAI-compatible servers use it to select which loaded model answers and reject (or, worse, silently try to fetch) an unrecognized one — the same failure mode confirmed live against `mlx_lm.server` for the managed MLX adapter. Defaults to `id` when omitted, which is only correct if the two happen to match; set this explicitly whenever they don't.",
          "type": [
            "string",
            "null"
          ]
        },
        "supports_grammar": {
          "description": "Defaults to `false` — constrained/grammar decoding is far less standardized across third-party servers than native tool calls.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_native_tools": {
          "description": "Defaults to `true` (most modern OpenAI-compatible servers support native `tool_calls`); set `false` for one that doesn't.",
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ModelIdRequest": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "ModelInstallRequest": {
      "description": "`model_install` — begin a download. `accept_license` is the wire record of the user's acceptance of the model's license (its text is on `ModelInspectResponse::license_text`). Core **refuses** the install with `model.license_not_accepted` when it is `false`, so no weights are ever fetched without an explicit acknowledgement (§4.21).",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "accept_license": {
          "default": false,
          "type": "boolean"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "ModelRecommendRequest": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "description": "A `ModelRole` name: `primary_coder`, `fast_coder`, `planner`, `reviewer`, `embedder`, `reranker`, `autocomplete`, `summarizer`.",
          "type": "string"
        }
      }
    },
    "PermissionResolveRequest": {
      "type": "object",
      "required": [
        "approve",
        "task_id"
      ],
      "properties": {
        "approve": {
          "description": "Legacy approve/deny (protocol 1.0). Ignored when `decision` is set.",
          "type": "boolean"
        },
        "decision": {
          "description": "`once` (approve this call), `task` (approve and grant for the rest of the task — \"Allow for Task\"), or `deny`. Overrides `approve` when set. Additive as of protocol 1.8.0.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "description": "The `request_id` from the `approval_requested` payload (G2). When present it is asserted against the daemon's current pending request; a stale id is rejected with `approval.superseded` rather than resolving the wrong prompt.",
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": "string"
        }
      }
    },
    "SearchQueryRequest": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "anchors": {
          "description": "Files the current task is anchored on — they seed dependency-mode traversal and pull nearby files up the ranking.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limit": {
          "description": "Max hits. Defaults to 20, capped at 200.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "modes": {
          "description": "Mode names (`lexical`, `symbol`, `semantic`, `regex`, `ast`, `dependency`, `git`). Empty runs the engine's default set. An unknown name is `search.unknown_mode`.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "query": {
          "description": "The query phrase, or a pattern for `regex` / `ast` modes.",
          "type": "string"
        }
      }
    },
    "StoragePurgeRequest": {
      "type": "object",
      "required": [
        "scope"
      ],
      "properties": {
        "dry_run": {
          "description": "When true, report what *would* be freed without deleting anything.",
          "default": false,
          "type": "boolean"
        },
        "scope": {
          "description": "`memory` | `cache` | `tasks` | `logs`.",
          "type": "string"
        }
      }
    },
    "TaskCreateRequest": {
      "type": "object",
      "required": [
        "objective"
      ],
      "properties": {
        "objective": {
          "type": "string"
        },
        "permission_mode": {
          "description": "Optional per-task autonomy override (§25). One of `manual` | `assisted` | `autonomous`. When absent, the task inherits the daemon's start-time mode. Additive as of protocol 1.1.0 — an older client omits it and gets the daemon default, unchanged.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskIdRequest": {
      "type": "object",
      "required": [
        "task_id"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        }
      }
    },
    "TaskRollbackRequest": {
      "type": "object",
      "required": [
        "checkpoint_id",
        "task_id"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      }
    },
    "TaskStatusRequest": {
      "type": "object",
      "required": [
        "task_id"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        }
      }
    }
  }
}
