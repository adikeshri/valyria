  "definitions": {
    "ConfigSetRequest": {
      "description": "Write one dotted config leaf to a Core-owned config file, then report the re-resolved effective view (§24). Additive as of protocol 1.1.0.\n\nThe write is validated against the policy floor (`valyria_config::validate_floor`) *before* it touches disk: a value that would loosen access past the compiled-in ceiling is rejected with `config.policy_floor_violation` and nothing is written.",
      "type": "object",
      "required": [
        "key",
        "scope",
        "value"
      ],
      "properties": {
        "key": {
          "description": "Dotted key, e.g. `permission.mode`, `log.format`, `network.internet`. Must be a key `config_show` already reports.",
          "type": "string"
        },
        "scope": {
          "description": "`workspace` writes `<repo>/.valyria/config.toml`; `user` writes `~/.valyria/config.toml`. Anything else is `config.invalid_scope`.",
          "type": "string"
        },
        "value": {
          "description": "The new value, as the string form `config_show` would display.",
          "type": "string"
        }
      }
    },
    "Empty": {
      "description": "An empty request payload. Kept as a named unit struct (rather than `()`) so it has a stable schema name and a place to grow fields.",
      "type": "object"
    },
    "EventsSubscribeRequest": {
      "type": "object",
      "required": [
        "since"
      ],
      "properties": {
        "since": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "task_id": {
          "description": "Restrict the stream to this task's events plus workspace-global (task-less) events (protocol 1.7.0, G11). Absent = the full stream.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "GitDiffRequest": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Restrict the diff to this exact repo-relative path.",
          "type": [
            "string",
            "null"
          ]
        },
        "staged": {
          "description": "`false` → worktree vs index (`git diff`); `true` → index vs HEAD (`git diff --staged`).",
          "default": false,
          "type": "boolean"
        }
      }
    },
    "GitLogRequest": {
      "type": "object",
      "properties": {
        "limit": {
          "description": "Newest-first commits from HEAD. Defaults to 50, capped at 500.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "HelloRequest": {
      "type": "object",
      "required": [
        "client_name"
      ],
      "properties": {
        "client_name": {
          "type": "string"
        }
      }
    },
    "LedgerChangesRequest": {
      "type": "object",
      "required": [
        "task_id"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        }
      }
    },
    "MemoryListRequest": {
      "type": "object",
      "properties": {
        "limit": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ModelActivateRequest": {
      "type": "object",
      "required": [
        "id",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "description": "The role to bind `id` to (a `ModelRole` name).",
          "type": "string"
        }
      }
    },
    "ModelIdRequest": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "ModelRecommendRequest": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "description": "A `ModelRole` name: `primary_coder`, `fast_coder`, `planner`, `reviewer`, `embedder`, `reranker`, `autocomplete`, `summarizer`.",
          "type": "string"
        }
      }
    },
    "PermissionResolveRequest": {
      "type": "object",
      "required": [
        "approve",
        "task_id"
      ],
      "properties": {
        "approve": {
          "description": "Legacy approve/deny (protocol 1.0). Ignored when `decision` is set.",
          "type": "boolean"
        },
        "decision": {
          "description": "`once` (approve this call), `task` (approve and grant for the rest of the task — \"Allow for Task\"), or `deny`. Overrides `approve` when set. Additive as of protocol 1.8.0.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "description": "The `request_id` from the `approval_requested` payload (G2). When present it is asserted against the daemon's current pending request; a stale id is rejected with `approval.superseded` rather than resolving the wrong prompt.",
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": "string"
        }
      }
    },
    "SearchQueryRequest": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "anchors": {
          "description": "Files the current task is anchored on — they seed dependency-mode traversal and pull nearby files up the ranking.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limit": {
          "description": "Max hits. Defaults to 20, capped at 200.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "modes": {
          "description": "Mode names (`lexical`, `symbol`, `semantic`, `regex`, `ast`, `dependency`, `git`). Empty runs the engine's default set. An unknown name is `search.unknown_mode`.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "query": {
          "description": "The query phrase, or a pattern for `regex` / `ast` modes.",
          "type": "string"
        }
      }
    },
    "StoragePurgeRequest": {
      "type": "object",
      "required": [
        "scope"
      ],
      "properties": {
        "dry_run": {
          "description": "When true, report what *would* be freed without deleting anything.",
          "default": false,
          "type": "boolean"
        },
        "scope": {
          "description": "`memory` | `cache` | `tasks` | `logs`.",
          "type": "string"
        }
      }
    },
    "TaskCreateRequest": {
      "type": "object",
      "required": [
        "objective"
      ],
      "properties": {
        "objective": {
          "type": "string"
        },
        "permission_mode": {
          "description": "Optional per-task autonomy override (§25). One of `manual` | `assisted` | `autonomous`. When absent, the task inherits the daemon's start-time mode. Additive as of protocol 1.1.0 — an older client omits it and gets the daemon default, unchanged.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskIdRequest": {
      "type": "object",
      "required": [
        "task_id"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        }
      }
    },
    "TaskRollbackRequest": {
      "type": "object",
      "required": [
        "checkpoint_id",
        "task_id"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      }
    },
    "TaskStatusRequest": {
      "type": "object",
      "required": [
        "task_id"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        }
      }
    }
  }
}
