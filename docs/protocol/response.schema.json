{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "result",
        "value"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "hello"
          ]
        },
        "value": {
          "$ref": "#/definitions/HelloResponse"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "result",
        "value"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "task_create"
          ]
        },
        "value": {
          "$ref": "#/definitions/TaskCreateResponse"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "result",
        "value"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "task_status"
          ]
        },
        "value": {
          "$ref": "#/definitions/TaskStatusResponse"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "result",
        "value"
      ],
