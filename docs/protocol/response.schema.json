  "definitions": {
    "ConfigEntryWire": {
      "type": "object",
      "required": [
        "key",
        "origin",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "origin": {
          "description": "Where the effective value came from: `default` | `global` | `workspace` | `env` | `task`.",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "ConfigShowResponse": {
      "type": "object",
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConfigEntryWire"
          }
        }
      }
    },
    "CpuInfoWire": {
      "description": "Mirrors `valyria_hardware::CpuInfo`.",
      "type": "object",
      "required": [
        "arch",
        "brand",
        "logical_cores",
        "physical_cores"
      ],
      "properties": {
        "arch": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "logical_cores": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "physical_cores": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "DoctorCheckWire": {
      "type": "object",
      "required": [
        "detail",
        "name",
        "status"
      ],
      "properties": {
        "detail": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "`pass` | `warn` | `fail`.",
          "type": "string"
        }
      }
    },
    "DoctorRunResponse": {
      "type": "object",
      "required": [
        "checks",
        "summary"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DoctorCheckWire"
          }
        },
        "summary": {
          "description": "The worst status across all checks: `pass` | `warn` | `fail`.",
          "type": "string"
        }
      }
    },
    "GitBranchWire": {
      "type": "object",
      "required": [
        "commit",
        "is_head",
        "name"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "is_head": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "GitBranchesResponse": {
      "type": "object",
      "required": [
        "branches"
      ],
      "properties": {
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GitBranchWire"
          }
        }
      }
    },
    "GitCommitWire": {
      "type": "object",
      "required": [
        "author_email",
        "author_name",
        "message",
        "parents",
        "sha",
        "time_unix"
      ],
      "properties": {
        "author_email": {
          "type": "string"
        },
        "author_name": {
          "type": "string"
        },
        "message": {
          "description": "The commit subject (first line).",
          "type": "string"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sha": {
          "type": "string"
        },
        "time_unix": {
          "description": "Author time, unix seconds.",
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "GitDiffResponse": {
      "type": "object",
      "required": [
        "truncated",
        "unified"
      ],
      "properties": {
        "truncated": {
          "description": "`true` when `unified` was clipped at Core's size cap.",
          "type": "boolean"
        },
        "unified": {
          "description": "Unified-diff text; empty when there is nothing to show.",
          "type": "string"
        }
      }
    },
    "GitFileStatusWire": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "staged"
      ],
      "properties": {
        "kind": {
          "description": "`added` | `modified` | `deleted` | `untracked` | `conflicted`.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "staged": {
          "description": "`true` for an index-vs-HEAD (staged) entry, `false` for a worktree-vs-index (unstaged / untracked) entry.",
          "type": "boolean"
        }
      }
    },
    "GitLogResponse": {
      "type": "object",
      "required": [
        "commits"
      ],
      "properties": {
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GitCommitWire"
          }
        }
      }
    },
    "GitStatusResponse": {
      "type": "object",
      "required": [
        "detached",
        "files"
      ],
      "properties": {
        "branch": {
          "description": "Current branch, or `None` when HEAD is detached.",
          "type": [
            "string",
            "null"
          ]
        },
        "detached": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GitFileStatusWire"
          }
        },
        "head_commit": {
          "description": "HEAD commit SHA, or `None` for an unborn HEAD.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "GpuInfoWire": {
      "description": "Mirrors `valyria_hardware::GpuInfo`. `vram_bytes` is `None` on a unified-memory system — meaningful, not missing.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "core_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "name": {
          "type": "string"
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "vram_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "HardwareProbeResponse": {
      "description": "Mirrors `valyria_hardware::HardwareReport` (§37, §39).",
      "type": "object",
      "required": [
        "arch",
        "cpu",
        "disk_available_bytes",
        "disk_total_bytes",
        "gpus",
        "os",
        "ram_available_bytes",
        "ram_total_bytes",
        "unified_memory"
      ],
      "properties": {
        "accelerator_present": {
          "description": "`Some(false)` = probed and absent; `None` = not probed on this platform yet.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "arch": {
          "type": "string"
        },
        "cpu": {
          "$ref": "#/definitions/CpuInfoWire"
        },
        "disk_available_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "disk_total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "gpus": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GpuInfoWire"
          }
        },
        "os": {
          "type": "string"
        },
        "os_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "ram_available_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "ram_total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "unified_memory": {
          "description": "CPU and GPU share one memory pool (Apple Silicon today).",
          "type": "boolean"
        }
      }
    },
    "HelloResponse": {
      "type": "object",
      "required": [
        "capabilities",
        "protocol_version",
        "runtime_version"
      ],
      "properties": {
        "capabilities": {
          "description": "What this runtime build can do — a client negotiates against this rather than the version string. Names are stable identifiers (`plan`, `daemon`, `doctor`, …); unknown names are ignored.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protocol_version": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        }
      }
    },
    "IndexStatusResponse": {
      "type": "object",
      "required": [
        "file_count",
        "symbol_count"
      ],
      "properties": {
        "created_at_ms": {
          "description": "When the current generation was published, unix milliseconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "file_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "generation": {
          "description": "`None` when the workspace has never been indexed.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "stage": {
          "description": "`files` | `complete` (the generation's `GenerationStage`).",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "LedgerChangeWire": {
      "type": "object",
      "required": [
        "classification",
        "kind",
        "path",
        "step_id",
        "task_id"
      ],
      "properties": {
        "classification": {
          "description": "`agent_authored` | `pre_existing` | `concurrent_user_modification` | `unknown` — computed against the file's on-disk state now.",
          "type": "string"
        },
        "kind": {
          "description": "`write` | `delete` — the agent's most recent action on the path.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "tool_invocation_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "LedgerChangesResponse": {
      "type": "object",
      "required": [
        "changes"
      ],
      "properties": {
        "changes": {
          "description": "One row per agent-touched path, path-ordered.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LedgerChangeWire"
          }
        }
      }
    },
    "MemoryEntryWire": {
      "type": "object",
      "required": [
        "author",
        "effective_confidence",
        "id",
        "kind",
        "scope",
        "text"
      ],
      "properties": {
        "author": {
          "type": "string"
        },
        "effective_confidence": {
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "MemoryListResponse": {
      "type": "object",
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MemoryEntryWire"
          }
        }
      }
    },
    "ModelCandidateWire": {
      "description": "One scored candidate for a role on this machine — mirrors `valyria_model_registry::CardScore` joined with its card. A card that will not fit is still listed, with `fit_kind = \"will_not_fit\"` and no `adjusted_score`.",
      "type": "object",
      "required": [
        "display_name",
        "family",
        "fit_kind",
        "id",
        "installed",
        "license_name",
        "size_bytes",
        "suitability"
      ],
      "properties": {
        "adjusted_score": {
          "description": "`suitability` minus the tight-fit penalty — the value Core ranks on. `None` when the card will not fit.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "display_name": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "fit_detail": {
          "description": "For `tight`, the estimated resource utilisation (0.0..~1.0); for `will_not_fit`, the reason (`insufficient_ram` | `insufficient_vram`).",
          "type": [
            "string",
            "null"
          ]
        },
        "fit_kind": {
          "description": "`comfortable` | `tight` | `will_not_fit`.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "installed": {
          "type": "boolean"
        },
        "license_name": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "suitability": {
          "description": "Catalog role suitability, 0..=100.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ModelInspectResponse": {
      "description": "Full detail for one model — mirrors the `ModelCard` plus, when installed, its `manifest.json` (§4.21). `license_text` is the license body when Core has it locally, for the acceptance prompt.",
      "type": "object",
      "required": [
        "active_roles",
        "context_length",
        "display_name",
        "family",
        "id",
        "installed",
        "license_name",
        "parameters_b",
        "quantization",
        "size_bytes",
        "source_url"
      ],
      "properties": {
        "active_roles": {
          "description": "The roles this model is currently bound to.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_length": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "display_name": {
          "type": "string"
        },
